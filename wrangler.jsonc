{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanqeh",
  "compatibility_date": "2026-01-01",
  "assets": {
    // single-page-app: any unknown path (e.g. /product/gulden-pro-7 opened
    // directly from a Google Ads click, or a page refresh) must serve
    // index.html instead of a 404, so the router can take over.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
